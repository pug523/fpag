{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FPAG_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "RelWithDebInfo, tests",
      "description": "What you want most of the time.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug, tests, assertions, stack symbols",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release, tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Debug with tests and benchmarks",
      "description": "The local development configuration, replaces scripts/local/c.sh.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FPAG_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Debug with the address, leak and undefined sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FPAG_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Debug instrumented for llvm-cov",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FPAG_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "tidy",
      "inherits": "base",
      "displayName": "Debug with clang-tidy as the compiler launcher",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FPAG_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "native",
      "inherits": "release",
      "displayName": "Release tuned for this machine",
      "description": "Not reproducible, not for CI.",
      "cacheVariables": {
        "FPAG_ENABLE_NATIVE": "ON",
        "FPAG_ENABLE_LTO": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    },
    {
      "name": "native",
      "configurePreset": "native"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "dev",
      "inherits": "base",
      "configurePreset": "dev"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan"
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage"
    }
  ]
}
